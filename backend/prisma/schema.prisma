// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   // SUPER_ADMIN, ADMIN, ACCOUNTANT, TEACHER, STUDENT, PARENT
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resetToken String?
  resetTokenExpiry DateTime?
  photoUrl String?

  studentProfile Student?
  staffProfile   StaffProfile?
  batches        Batch[]

}

model Student {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  regNo           String?  @unique
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  guardianName    String
  dob             DateTime
  gender          String
  phone           String
  address         String
  schoolName      String?
  madhyamikMarks  Float?
  hsMarksPhysics  Float?
  hsMarksChemistry Float?
  hsMarksBiology  Float?
  prevNeetMarks   Float?
  isResidential   Boolean  @default(false)
  photoUrl        String?
  aadhaarUrl      String?

  courses         StudentCourse[]
  fees            Fee[]
  payments        Payment[]
  attendances     Attendance[]
  results         Result[]
  hostelAlloc     HostelAllocation?
  leavePasses     LeavePass[]
  inventoryIssues InventoryIssue[]
  scholarshipTier String?          // MERIT_A, MERIT_B, MERIT_C, NONE

  transportAlloc  TransportAllocation?
  certificates    CertificateRecord[]
  cbtAttempts     CbtAttempt[]
}

model Course {
  id          String   @id @default(uuid())
  name        String   // NEET, JEE, Board
  description String?
  duration    String?  // 1 Year, 2 Year, Crash
  createdAt   DateTime @default(now())

  batches     Batch[]
  students    StudentCourse[]
  fees        Fee[]
}

model Batch {
  id          String   @id @default(uuid())
  name        String   // Alpha, Helix, Crash
  courseId    String
  teacherId   String?
  course      Course   @relation(fields: [courseId], references: [id])
  teacher     User?    @relation(fields: [teacherId], references: [id])
  
  attendances Attendance[]
  timetable   Timetable?
  studentCourses StudentCourse[]
  cbtExams    CbtExam[] @relation("BatchExams")
}

model StudentCourse {
  studentId String
  courseId  String
  batchId   String?
  student   Student @relation(fields: [studentId], references: [id])
  course    Course  @relation(fields: [courseId], references: [id])
  batch     Batch?  @relation(fields: [batchId], references: [id])

  @@id([studentId, courseId])
}

model Fee {
  id          String   @id @default(uuid())
  studentId   String
  courseId    String
  amount      Float
  type        String   @default("ACADEMIC") // ACADEMIC, HOSTEL
  month       String?  // For hostel fees: JAN, FEB, etc.
  dueDate     DateTime
  lateFee     Float    @default(0)
  status      String   // PENDING, PAID, PARTIAL
  student     Student  @relation(fields: [studentId], references: [id])
  course      Course   @relation(fields: [courseId], references: [id])

  payments    Payment[]
}

model Payment {
  id            String   @id @default(uuid())
  feeId         String
  studentId     String
  amount        Float
  paymentMode   String   // CASH, UPI, ONLINE
  transactionId String?
  date          DateTime @default(now())
  fee           Fee      @relation(fields: [feeId], references: [id])
  student       Student  @relation(fields: [studentId], references: [id])
}

model Attendance {
  id              String         @id @default(uuid())
  studentId       String
  batchId         String
  timetableSlotId String?
  date            DateTime
  status          String         // PRESENT, ABSENT, LATE
  student         Student        @relation(fields: [studentId], references: [id])
  batch           Batch          @relation(fields: [batchId], references: [id])
  timetableSlot   TimetableSlot? @relation(fields: [timetableSlotId], references: [id])
}

model Test {
  id          String   @id @default(uuid())
  title       String
  type        String   // DPP, WEEKLY, MOCK
  date        DateTime
  maxMarks    Float
  
  results     Result[]
}

model Result {
  id          String   @id @default(uuid())
  testId      String
  studentId   String
  marksObtained Float
  test        Test     @relation(fields: [testId], references: [id])
  student     Student  @relation(fields: [studentId], references: [id])
}

model Hostel {
  id          String   @id @default(uuid())
  roomNumber  String   @unique
  capacity    Int
  occupancy   Int      @default(0)

  allocations HostelAllocation[]
}

model HostelAllocation {
  id          String   @id @default(uuid())
  studentId   String   @unique
  hostelId    String
  joinDate    DateTime
  leaveDate   DateTime?
  student     Student  @relation(fields: [studentId], references: [id])
  hostel      Hostel   @relation(fields: [hostelId], references: [id])
}

model Expense {
  id          String   @id @default(uuid())
  title       String
  category    String   // Reference to ExpenseCategory.name
  amount      Float
  date        DateTime
  description String?
  payeeName   String?
  purpose     String?
  fundSource  String   @default("GENERAL") // GENERAL, RESERVE
}

model ExpenseCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String
  type        String   // ACADEMIC, GENERAL, URGENT
  targetAudience String // ALL, STUDENTS, STAFF
  createdAt   DateTime @default(now())
}

model InstitutionSettings {
  id               String  @id @default("singleton")
  lateFeePerDay    Float   @default(10)   // ₹ per day
  gracePeriodDays  Int     @default(0)    // days before late fee kicks in
  lateFeeEnabled   Boolean @default(true)
  institutionName  String  @default("Rankers' Platform")
  phone            String? @default("+91 00000 00000")
  email            String? @default("info@rankersplatform.com")
  website          String? @default("www.rankersplatform.com")
  address          String? @default("Main Campus, City")
  gstNumber        String? 
  tagline          String? @default("Empowering Future Leaders")
  principalName    String?
  reserveFundPercentage Float @default(60)
  updatedAt        DateTime @updatedAt
}

model AdmissionInquiry {
  id              String   @id @default(uuid())
  name            String
  guardianName    String
  dob             DateTime
  gender          String
  phone           String
  email           String
  address         String
  schoolName      String?
  courseInterest  String?  // NEET, JEE, etc.
  status          String   @default("NEW") // NEW, CONTACTED, REGISTERED, REJECTED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LeavePass {
  id          String   @id @default(uuid())
  studentId   String
  reason      String
  destination String
  startDate   DateTime
  endDate     DateTime
  status      String   @default("APPROVED") // APPROVED, REJECTED, PENDING, RETURNED
  passNo      String   @unique
  issuedBy    String   // Admin/Staff name
  issuedAt    DateTime @default(now())
  returnedAt  DateTime?
  notes       String?
  student     Student  @relation(fields: [studentId], references: [id])
}

model Timetable {
  id        String          @id @default(uuid())
  batchId   String          @unique
  batch     Batch           @relation(fields: [batchId], references: [id])
  slots     TimetableSlot[]
  updatedAt DateTime        @updatedAt
}

model TimetableSlot {
  id          String    @id @default(uuid())
  timetableId String
  day         String    // MON, TUE, WED, THU, FRI, SAT
  startTime   String    // e.g. "09:00"
  endTime     String    // e.g. "10:30"
  subject     String
  teacherName String?
  roomNo      String?
  timetable   Timetable @relation(fields: [timetableId], references: [id])
  attendances Attendance[]
}

model InventoryItem {
  id          String           @id @default(uuid())
  name        String
  category    String           // BOOK, EQUIPMENT, STATIONERY, OTHER
  totalQty    Int
  availableQty Int
  description String?
  createdAt   DateTime         @default(now())
  issues      InventoryIssue[]
}

model InventoryIssue {
  id        String        @id @default(uuid())
  itemId    String
  studentId String
  issuedOn  DateTime      @default(now())
  dueDate   DateTime
  returnedOn DateTime?
  condition String?       // GOOD, DAMAGED
  item      InventoryItem @relation(fields: [itemId], references: [id])
  student   Student       @relation(fields: [studentId], references: [id])
}

model StaffProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  designation   String
  department    String?
  baseSalary    Float    @default(0)
  bankAccount   String?
  ifscCode      String?
  joiningDate   DateTime @default(now())

  salaryRecords SalaryRecord[]
}

model SalaryRecord {
  id              String       @id @default(uuid())
  staffProfileId  String
  staffProfile    StaffProfile @relation(fields: [staffProfileId], references: [id])
  month           String
  basicSalary     Float
  allowances      Float        @default(0)
  deductions      Float        @default(0)
  netSalary       Float
  paymentMode     String       @default("CASH")
  transactionId   String?
  paidAt          DateTime     @default(now())
  remarks         String?
  status          String       @default("PAID")
}

model GuestTeacher {
  id            String         @id @default(uuid())
  name          String
  phone         String?
  email         String?
  subject       String
  qualification String?
  ratePerClass  Float
  createdAt     DateTime       @default(now())

  payments      GuestPayment[]
}

model GuestPayment {
  id             String       @id @default(uuid())
  guestTeacherId String
  guestTeacher   GuestTeacher @relation(fields: [guestTeacherId], references: [id])
  month          String
  classesHeld    Int
  ratePerClass   Float
  classAmount    Float
  allowances     Float        @default(0)
  totalAmount    Float
  paymentMode    String       @default("CASH")
  transactionId  String?
  remarks        String?
  paidAt         DateTime     @default(now())
  status         String       @default("PAID")
}

model Vehicle {
  id              String   @id @default(uuid())
  registrationNo  String   @unique
  capacity        Int
  driverName      String
  driverPhone     String?
  allocations     TransportAllocation[]
}

model Route {
  id              String   @id @default(uuid())
  name            String
  stops           String   // E.g. "StopA, StopB, StopC"
  monthlyFee      Float
  allocations     TransportAllocation[]
}

model TransportAllocation {
  id          String   @id @default(uuid())
  studentId   String   @unique
  vehicleId   String
  routeId     String
  startDate   DateTime @default(now())
  student     Student  @relation(fields: [studentId], references: [id])
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  route       Route    @relation(fields: [routeId], references: [id])
}

model CertificateRecord {
  id              String   @id @default(uuid())
  studentId       String
  type            String   // BONAFIDE, TRANSFER, LEAVING
  issueDate       DateTime @default(now())
  referenceNumber String   @unique
  issuedBy        String
  remarks         String?
  student         Student  @relation(fields: [studentId], references: [id])
}

model OtherIncome {
  id            String   @id @default(uuid())
  title         String
  category      String   // DONATION, SPONSORSHIP, SCRAP_SALE, INVESTMENT, OTHER
  amount        Float
  date          DateTime @default(now())
  description   String?
  receivedFrom  String?
  paymentMode   String   @default("CASH") // CASH, UPI, ONLINE, CHEQUE
  transactionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// --- CBT Exam System Models ---

model Question {
  id            String   @id @default(uuid())
  content       String   // Question text (supports LaTeX)
  type          String   @default("MCQ") // MCQ, MULTI_SELECT, INTEGER
  subject       String   // PHYSICS, CHEMISTRY, BIOLOGY, MATHS
  topic         String?
  subTopic      String?
  difficulty    String   @default("MEDIUM") // EASY, MEDIUM, HARD
  
  options       Json     // Array of options: [{id: 'A', text: '...', isCorrect: boolean}]
  correctOption String   // ID of the correct option
  explanation   String?
  imageUrl      String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  examQuestions CbtExamQuestion[]
  responses     CbtResponse[]
}

model CbtExam {
  id            String   @id @default(uuid())
  title         String
  description   String?
  startTime     DateTime
  endTime       DateTime
  duration      Int      // In minutes
  totalMarks    Int
  
  // Marking Scheme
  positiveMarks Float    @default(4)
  negativeMarks Float    @default(1)
  
  status        String   @default("DRAFT") // DRAFT, PUBLISHED, COMPLETED
  examPattern   String   @default("STANDARD") // STANDARD, NEET_NTA
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  questions     CbtExamQuestion[]
  attempts      CbtAttempt[]
  batches       Batch[]          @relation("BatchExams")
}

model CbtExamQuestion {
  id         String   @id @default(uuid())
  examId     String
  questionId String
  order      Int      @default(0)
  section    String?  // Section A, Section B (for NEET pattern)
  
  exam       CbtExam  @relation(fields: [examId], references: [id])
  question   Question @relation(fields: [questionId], references: [id])

  @@unique([examId, questionId])
}

model CbtAttempt {
  id          String   @id @default(uuid())
  studentId   String
  examId      String
  startTime   DateTime @default(now())
  submitTime  DateTime?
  score       Float    @default(0)
  status      String   @default("STARTED") // STARTED, SUBMITTED, EVALUATED
  
  securityAlerts Int    @default(0)
  isTerminated   Boolean @default(false)
  lastHeartbeat  DateTime?
  
  student     Student  @relation(fields: [studentId], references: [id])
  exam        CbtExam  @relation(fields: [examId], references: [id])
  responses   CbtResponse[]

  @@unique([studentId, examId])
}

model CbtResponse {
  id           String   @id @default(uuid())
  attemptId    String
  questionId   String
  selectedOption String? // ID of the option selected
  isCorrect    Boolean?
  timeSpent    Int      @default(0) // Seconds spent on this question
  
  attempt      CbtAttempt @relation(fields: [attemptId], references: [id])
  question     Question   @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}
